{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_DISABLE_TELEMETRY": "true",
        "MCP_DISABLE_TELEMETRY": "true",
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "modeler-harness": {
      "command": "rust/target/release/mh.exe",
      "args": [
        "mcp"
      ]
    }
  }
}